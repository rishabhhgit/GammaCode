# GammaCode server environment — copy this file to apps/server/.env
# and fill in at least ONE provider key. Keys can also be added later
# in the app's Settings panel (stored encrypted in ~/.gamma-code/auth.json).

# --- AI provider API keys (any subset) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# GitHub personal access token for Copilot (or use the in-app device login)
GITHUB_TOKEN=

# --- Optional server settings ---
# HTTP API port (web client defaults to http://127.0.0.1:3030)
# PORT=3030
# WebSocket terminal port
# WS_PORT=3031
# Directory the editor treats as the workspace root (defaults to repo root)
# WORKSPACE_ROOT=
# Password-protect the web UI (sent as Bearer token / ?token=)
# GAMMA_CODE_WEB_PASSWORD=

# --- Agent / task tuning ---
# Max agentic tool rounds per user message (default 50, max 200)
# GAMMA_CODE_MAX_TOOL_ROUNDS=50
# Shell command timeout in ms for AI-run commands (default 300000 = 5 min)
# GAMMA_CODE_COMMAND_TIMEOUT_MS=300000
# Abort a provider stream if it sends no bytes for this long (default 180000)
# GAMMA_CODE_STREAM_IDLE_TIMEOUT_MS=180000
# Log level: debug | info | warn | error
# GAMMA_CODE_LOG_LEVEL=info

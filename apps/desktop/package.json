{
  "name": "@gamma-code/desktop",
  "version": "0.1.0",
  "description": "AI-powered code editor",
  "author": "Aarush Tanwar",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron dist/main.js",
    "build": "tsc -p tsconfig.json",
"build:web": "pnpm --filter @gamma-code/web build",
      "build:server": "pnpm --filter @gamma-code/server build",
    "build:all": "pnpm build:web && pnpm build:server && pnpm build",
    "start": "electron dist/main.js",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm build:all && electron-builder",
    "dist:mac": "pnpm build:all && electron-builder --mac",
    "dist:win": "pnpm build:all && electron-builder --win",
    "dist:linux": "pnpm build:all && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^36.5.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.gammacode.app",
    "productName": "Gamma Code",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../../web/dist/**/*",
      "../../server/dist/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "Thisisaarush",
      "repo": "GammaCode"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
